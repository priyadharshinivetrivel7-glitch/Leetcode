class Solution {
    public int longestSubstring(String s, int k) {
        int ans = 0;
        for(int i  = 0 ;i<s.length();i++){
            int[] count = new int[26];
            for(int j = i;j<s.length();j++){
                count[s.charAt(j)-'a']++;
                boolean ok = true;
                for(int x = 0;x<26;x++){
                    if(count[x]>0 && count[x]<k){
                        ok = false;
                    }
                }
                if(ok){
                    ans = Math.max(ans,j-i+1);
                }
        
            }
        }
        return ans;
    }
}
