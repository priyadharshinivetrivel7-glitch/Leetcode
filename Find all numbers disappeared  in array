class Solution {
    public List<Integer> findDisappearedNumbers(int[] nums) {
        Set<Integer> a = new HashSet<>();
        List<Integer> b = new LinkedList<>();
        for(int c:nums){
            a.add(c);
        }
        for(int i=1;i<=nums.length;i++){
            if(!a.contains(i)){
                b.add(i);
            }
        }
        return b;
    }
}
